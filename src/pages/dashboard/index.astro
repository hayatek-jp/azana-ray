export const prerender = false;

import { env } from 'cloudflare:workers';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import StatCard from '@/components/dashboard/StatCard.astro';
import BarChart from '@/components/dashboard/BarChart.astro';
import { getDashboardStats } from '@/server/stats';

const stats = await getDashboardStats(env);
const { hostGroups, dailyStats } = stats;
---

<DashboardLayout title="ダッシュボード" currentPath="/dashboard/">
	<div class="stats-grid">
		<StatCard
			label="総URL数"
			value={stats.totalUrls}
			icon="🔗"
			sub="アクティブ"
		/>
		<StatCard
			label="総アクセス数"
			value={stats.totalClicks}
			icon="👆"
			trend="up"
			trendValue="+12.3%"
		/>
		<StatCard
			label="本日のアクセス"
			value={stats.todayClicks}
			icon="📅"
			trend="up"
			trendValue="+5"
		/>
		<StatCard
			label="今週のアクセス"
			value={stats.weeklyClicks}
			icon="📆"
			trend="up"
			trendValue="+8.7%"
		/>
		<StatCard
			label="今月のアクセス"
			value={stats.monthlyClicks}
			icon="🗓️"
			trend="up"
			trendValue="+15.2%"
		/>
		<StatCard
			label="ホストグループ数"
			value={stats.hostGroupCount}
			icon="🏷️"
			sub="ドメイン"
		/>
	</div>

	<div class="section">
		<BarChart data={dailyStats} title="直近30日間のアクセス推移" />
	</div>

	<div class="section">
		<div class="section-header">
			<h2 class="section-title">ホスト別グループ</h2>
			<a href="/dashboard/urls/" class="view-all">すべて表示 →</a>
		</div>
		<div class="host-groups">
			{hostGroups.map((group) => (
				<div class="host-card">
					<div class="host-card-header">
						<span class="host-icon">🌐</span>
						<a href={`/dashboard/urls/${group.hostname}/`} class="host-name host-card-link">{group.hostname}</a>
					</div>
					<div class="host-card-stats">
						<div class="host-stat">
							<span class="host-stat-value">{group.urlCount}</span>
							<span class="host-stat-label">URL数</span>
						</div>
						<div class="host-stat">
							<span class="host-stat-value">{group.totalClicks.toLocaleString()}</span>
							<span class="host-stat-label">アクセス</span>
						</div>
					</div>
					<div class="host-card-actions">
						<span class="link-btn">URL一覧</span>
						<a href={`/dashboard/analytics/${group.hostname}/`} class="link-btn link-btn-secondary">アクセス解析</a>
					</div>
				</div>
			))}
		</div>
	</div>
</DashboardLayout>

<style>
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 16px;
		margin-bottom: 28px;
	}

	.section {
		margin-bottom: 28px;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.section-title {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.view-all {
		font-size: 0.85rem;
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
	}

	.view-all:hover {
		color: var(--color-primary-hover);
	}

	.host-groups {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.host-card {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 20px;
		text-decoration: none;
		color: var(--color-text);
		transition: all 0.15s ease;
		display: flex;
		flex-direction: column;
		gap: 14px;
		position: relative;
	}

	.host-card-link {
		color: inherit;
		text-decoration: none;
	}

	/* カード全体をクリック可能にする */
	.host-card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.host-card:hover {
		border-color: var(--color-primary);
		transform: translateY(-1px);
	}

	.host-card-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.host-icon {
		font-size: 1.3em;
	}

	.host-name {
		font-size: 0.95rem;
		font-weight: 600;
		word-break: break-all;
	}

	.host-card-stats {
		display: flex;
		gap: 24px;
	}

	.host-stat {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.host-stat-value {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.host-stat-label {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.host-card-actions {
		display: flex;
		gap: 8px;
	}

	.link-btn {
		font-size: 0.78rem;
		padding: 5px 12px;
		border-radius: var(--radius-sm);
		background: var(--color-primary-bg);
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
		transition: background 0.15s ease;
	}

	a.link-btn {
		position: relative;
		z-index: 1;
	}

	.link-btn:hover {
		background: rgba(108, 138, 255, 0.2);
	}

	.link-btn-secondary {
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
	}

	.link-btn-secondary:hover {
		background: var(--color-bg-hover);
		color: var(--color-text);
	}
</style>
