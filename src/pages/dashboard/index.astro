export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import StatCard from '@/components/dashboard/StatCard.astro';
import BarChart from '@/components/dashboard/BarChart.astro';
import type { HostGroup, DailyStats, AccessLog } from '@/types/url';

const env = Astro.locals.runtime.env;

// URL一覧を取得しグループ化 & 統計集計
let totalUrls = 0;
let totalClicks = 0;
const hostnameMap = new Map<string, { urlCount: number; totalClicks: number }>();

let urlList = await env.URLS.list();
while (true) {
    for (const k of urlList.keys) {
        const dest = await env.URLS.get(k.name);
        if (!dest || dest.startsWith('disabled:')) continue;
        totalUrls++;
        // アクセス数カウント
        let clicks = 0;
        let logList = await env.ACCESS_LOGS.list({ prefix: `log:${k.name}:` });
        clicks += logList.keys.length;
        while (!logList.list_complete) {
            logList = await env.ACCESS_LOGS.list({ prefix: `log:${k.name}:`, cursor: logList.cursor });
            clicks += logList.keys.length;
        }
        totalClicks += clicks;
        try {
            const hostname = new URL(dest).hostname;
            const existing = hostnameMap.get(hostname) ?? { urlCount: 0, totalClicks: 0 };
            existing.urlCount++;
            existing.totalClicks += clicks;
            hostnameMap.set(hostname, existing);
        } catch { /* skip */ }
    }
    if (urlList.list_complete) break;
    urlList = await env.URLS.list({ cursor: urlList.cursor });
}

const hostGroups: HostGroup[] = [...hostnameMap.entries()]
    .map(([hostname, data]) => ({ hostname, ...data }))
    .sort((a, b) => b.totalClicks - a.totalClicks);

// 期間別アクセス数
const now = Date.now();
const todayStart = new Date().setHours(0, 0, 0, 0);
const weekStart = now - 7 * 24 * 60 * 60 * 1000;
const monthStart = now - 30 * 24 * 60 * 60 * 1000;
let todayClicks = 0, weeklyClicks = 0, monthlyClicks = 0;

// 日別統計用マップ (直近30日)
const dailyMap = new Map<string, number>();
for (let i = 29; i >= 0; i--) {
    const d = new Date(now);
    d.setDate(d.getDate() - i);
    dailyMap.set(d.toISOString().slice(0, 10), 0);
}

// 全ログを走査
let logListAll = await env.ACCESS_LOGS.list({ prefix: 'log:' });
while (true) {
    for (const k of logListAll.keys) {
        const raw = await env.ACCESS_LOGS.get(k.name);
        if (!raw) continue;
        try {
            const log: AccessLog = JSON.parse(raw);
            const ts = new Date(log.timestamp).getTime();
            if (ts >= todayStart) todayClicks++;
            if (ts >= weekStart) weeklyClicks++;
            if (ts >= monthStart) monthlyClicks++;
            const date = log.timestamp.slice(0, 10);
            if (dailyMap.has(date)) {
                dailyMap.set(date, dailyMap.get(date)! + 1);
            }
        } catch { /* skip */ }
    }
    if (logListAll.list_complete) break;
    logListAll = await env.ACCESS_LOGS.list({ prefix: 'log:', cursor: logListAll.cursor });
}

const stats = {
    totalUrls,
    totalClicks,
    todayClicks,
    weeklyClicks,
    monthlyClicks,
    hostGroupCount: hostnameMap.size,
};

const dailyStats: DailyStats[] = [...dailyMap.entries()].map(([date, clicks]) => ({ date, clicks }));
---

<DashboardLayout title="ダッシュボード" currentPath="/dashboard/">
	<div class="stats-grid">
		<StatCard
			label="総URL数"
			value={stats.totalUrls}
			icon="🔗"
			sub="アクティブ"
		/>
		<StatCard
			label="総アクセス数"
			value={stats.totalClicks}
			icon="👆"
			trend="up"
			trendValue="+12.3%"
		/>
		<StatCard
			label="本日のアクセス"
			value={stats.todayClicks}
			icon="📅"
			trend="up"
			trendValue="+5"
		/>
		<StatCard
			label="今週のアクセス"
			value={stats.weeklyClicks}
			icon="📆"
			trend="up"
			trendValue="+8.7%"
		/>
		<StatCard
			label="今月のアクセス"
			value={stats.monthlyClicks}
			icon="🗓️"
			trend="up"
			trendValue="+15.2%"
		/>
		<StatCard
			label="ホストグループ数"
			value={stats.hostGroupCount}
			icon="🏷️"
			sub="ドメイン"
		/>
	</div>

	<div class="section">
		<BarChart data={dailyStats} title="直近30日間のアクセス推移" />
	</div>

	<div class="section">
		<div class="section-header">
			<h2 class="section-title">ホスト別グループ</h2>
			<a href="/dashboard/urls/" class="view-all">すべて表示 →</a>
		</div>
		<div class="host-groups">
			{hostGroups.map((group) => (
				<a href={`/dashboard/urls/${group.hostname}/`} class="host-card">
					<div class="host-card-header">
						<span class="host-icon">🌐</span>
						<span class="host-name">{group.hostname}</span>
					</div>
					<div class="host-card-stats">
						<div class="host-stat">
							<span class="host-stat-value">{group.urlCount}</span>
							<span class="host-stat-label">URL数</span>
						</div>
						<div class="host-stat">
							<span class="host-stat-value">{group.totalClicks.toLocaleString()}</span>
							<span class="host-stat-label">アクセス</span>
						</div>
					</div>
					<div class="host-card-actions">
						<span class="link-btn">URL一覧</span>
						<a href={`/dashboard/analytics/${group.hostname}/`} class="link-btn link-btn-secondary" onclick="event.stopPropagation()">アクセス解析</a>
					</div>
				</a>
			))}
		</div>
	</div>
</DashboardLayout>

<style>
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 16px;
		margin-bottom: 28px;
	}

	.section {
		margin-bottom: 28px;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.section-title {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.view-all {
		font-size: 0.85rem;
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
	}

	.view-all:hover {
		color: var(--color-primary-hover);
	}

	.host-groups {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.host-card {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 20px;
		text-decoration: none;
		color: var(--color-text);
		transition: all 0.15s ease;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.host-card:hover {
		border-color: var(--color-primary);
		transform: translateY(-1px);
	}

	.host-card-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.host-icon {
		font-size: 1.3em;
	}

	.host-name {
		font-size: 0.95rem;
		font-weight: 600;
		word-break: break-all;
	}

	.host-card-stats {
		display: flex;
		gap: 24px;
	}

	.host-stat {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.host-stat-value {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.host-stat-label {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.host-card-actions {
		display: flex;
		gap: 8px;
	}

	.link-btn {
		font-size: 0.78rem;
		padding: 5px 12px;
		border-radius: var(--radius-sm);
		background: var(--color-primary-bg);
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
		transition: background 0.15s ease;
	}

	.link-btn:hover {
		background: rgba(108, 138, 255, 0.2);
	}

	.link-btn-secondary {
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
	}

	.link-btn-secondary:hover {
		background: var(--color-bg-hover);
		color: var(--color-text);
	}
</style>
