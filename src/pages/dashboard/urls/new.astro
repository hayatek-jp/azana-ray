// SPDX-License-Identifier: AGPL-3.0-only

export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';

const referrer = Astro.request.headers.get('referer') ?? '/dashboard/urls/';
---

<DashboardLayout title="新規URL作成" currentPath="/dashboard/urls/">
	<nav class="breadcrumb">
		<a href="/dashboard/">ダッシュボード</a>
		<span class="sep">/</span>
		<a href="/dashboard/urls/">URL管理</a>
		<span class="sep">/</span>
		<span class="current">新規作成</span>
	</nav>

	<div class="form-card">
		<form id="createForm">
			<div class="form-group">
				<label for="destination" class="form-label">遷移先URL <span class="required">*</span></label>
				<input
					type="url"
					id="destination"
					name="destination"
					class="form-input"
					placeholder="https://example.com/page"
					required
				/>
				<span class="form-hint">リダイレクト先のURLを入力してください。</span>
			</div>

			<div class="form-group">
				<label for="customKey" class="form-label">カスタムキー（任意）</label>
				<div class="input-prefix-wrap">
					<span class="input-prefix">/</span>
					<input
						type="text"
						id="customKey"
						name="customKey"
						class="form-input input-with-prefix"
						placeholder="my-link"
						pattern="[a-z0-9\-]+"
					/>
				</div>
				<span class="form-hint">空の場合は自動生成されます。英小文字・数字・ハイフンが使用できます。</span>
			</div>

			<div class="form-group">
				<label for="comment" class="form-label">コメント（任意）</label>
				<textarea
					id="comment"
					name="comment"
					class="form-input form-textarea"
					placeholder="このURLについてのメモ..."
					rows="3"
				></textarea>
				<span class="form-hint">管理用のメモを自由に記入できます。</span>
			</div>

			<div class="form-actions">
				<a href={referrer} class="btn btn-secondary">キャンセル</a>
				<button type="submit" class="btn btn-primary">作成する</button>
			</div>
		</form>
	</div>

	<!-- 成功モーダル -->
	<div class="modal-overlay" id="successModal" hidden>
		<div class="modal">
			<div class="success-icon">✅</div>
			<h3 class="modal-title">URLを作成しました</h3>
			<div class="result-info">
				<div class="result-row">
					<span class="result-label">短縮URL</span>
					<code class="result-value" id="resultUrl"></code>
				</div>
				<div class="result-row">
					<span class="result-label">遷移先</span>
					<span class="result-value result-dest" id="resultDest"></span>
				</div>
			</div>
			<div class="modal-actions">
				<button class="btn btn-secondary" id="copyResult">📋 URLをコピー</button>
				<a href="/dashboard/urls/" class="btn btn-primary">URL一覧へ</a>
			</div>
		</div>
	</div>
</DashboardLayout>

<script>
	const form = document.getElementById('createForm') as HTMLFormElement;
	const successModal = document.getElementById('successModal')!;
	const resultUrl = document.getElementById('resultUrl')!;
	const resultDest = document.getElementById('resultDest')!;
	const copyResult = document.getElementById('copyResult')!;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		const destination = (document.getElementById('destination') as HTMLInputElement).value;
		const customKey = (document.getElementById('customKey') as HTMLInputElement).value;
		const comment = (document.getElementById('comment') as HTMLTextAreaElement).value;

		try {
			const body: Record<string, string> = { destination };
			if (customKey) body.customKey = customKey;
			if (comment) body.comment = comment;

			const res = await fetch('/api/urls', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});

			if (res.ok) {
				const data = await res.json() as { key: string };
				const shortUrl = `${window.location.origin}/${data.key}`;
				resultUrl.textContent = shortUrl;
				resultDest.textContent = destination;
				successModal.hidden = false;
			} else if (res.status === 409) {
				alert('このカスタムキーは既に使用されています。');
			} else {
				alert('作成に失敗しました。');
			}
		} catch {
			alert('作成に失敗しました。');
		}
	});

	copyResult.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(resultUrl.textContent ?? '');
			copyResult.textContent = '✅ コピーしました';
			setTimeout(() => { copyResult.textContent = '📋 URLをコピー'; }, 2000);
		} catch {
			// clipboard API not available
		}
	});

	successModal.addEventListener('click', (e) => {
		if (e.target === successModal) successModal.hidden = true;
	});
</script>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
		font-size: 0.85rem;
	}

	.breadcrumb a {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.breadcrumb a:hover { color: var(--color-primary); }
	.breadcrumb .sep { color: var(--color-text-muted); }
	.breadcrumb .current { color: var(--color-text); font-weight: 500; }

	.form-card {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 28px;
		max-width: 640px;
	}

	.form-group {
		margin-bottom: 22px;
	}

	.form-label {
		display: block;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-text);
		margin-bottom: 6px;
	}

	.required {
		color: var(--color-danger);
	}

	.form-input {
		width: 100%;
		padding: 10px 14px;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		font-size: 0.9rem;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.form-input:focus {
		border-color: var(--color-primary);
	}

	.form-input::placeholder { color: var(--color-text-muted); }

	.input-prefix-wrap {
		display: flex;
		align-items: center;
	}

	.input-prefix {
		padding: 10px 0 10px 14px;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		border-right: none;
		border-radius: var(--radius-md) 0 0 var(--radius-md);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		font-family: monospace;
	}

	.input-with-prefix {
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
	}

	.form-textarea {
		resize: vertical;
		min-height: 80px;
		font-family: inherit;
	}

	.form-hint {
		display: block;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		margin-top: 5px;
	}

	.form-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 28px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 20px;
		border-radius: var(--radius-md);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.15s ease;
	}

	.btn-primary { background: var(--color-primary); color: #fff; }
	.btn-primary:hover { background: var(--color-primary-hover); }
	.btn-secondary {
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
	}
	.btn-secondary:hover { color: var(--color-text); background: var(--color-bg-hover); }

	/* モーダル */
	.modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
	}

	.modal-overlay[hidden] { display: none; }

	.modal {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 32px;
		max-width: 480px;
		width: 90%;
		text-align: center;
	}

	.success-icon {
		font-size: 2.5em;
		margin-bottom: 12px;
	}

	.modal-title {
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 20px;
	}

	.result-info {
		text-align: left;
		background: var(--color-bg-tertiary);
		border-radius: var(--radius-md);
		padding: 16px;
		margin-bottom: 20px;
	}

	.result-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 6px 0;
		gap: 12px;
	}

	.result-row + .result-row {
		border-top: 1px solid var(--color-border);
		margin-top: 6px;
		padding-top: 12px;
	}

	.result-label {
		font-size: 0.82rem;
		color: var(--color-text-secondary);
		flex-shrink: 0;
	}

	.result-value {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-primary);
		word-break: break-all;
		text-align: right;
	}

	.result-dest {
		color: var(--color-text);
		font-weight: 400;
	}

	.modal-actions {
		display: flex;
		justify-content: center;
		gap: 10px;
	}
</style>
