export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import type { ShortenedUrl, UrlMeta } from '@/types/url';

const { hostname, key } = Astro.params;

if (!hostname || !key) {
	return Astro.redirect('/dashboard/urls/');
}

const env = Astro.locals.runtime.env;

const destination = await env.URLS.get(key);
if (!destination || destination.startsWith('disabled:')) {
	return Astro.redirect(`/dashboard/urls/${hostname}/`);
}

const metaRaw = await env.URL_META.get(key);
const meta: UrlMeta = metaRaw
	? JSON.parse(metaRaw)
	: { comment: '', createdAt: '' };

let clicks = 0;
let logList = await env.ACCESS_LOGS.list({ prefix: `log:${key}:` });
clicks += logList.keys.length;
while (!logList.list_complete) {
	logList = await env.ACCESS_LOGS.list({ prefix: `log:${key}:`, cursor: logList.cursor });
	clicks += logList.keys.length;
}

const url: ShortenedUrl = {
	key,
	destination,
	comment: meta.comment,
	createdAt: meta.createdAt,
	totalClicks: clicks,
};
---

<DashboardLayout title={`編集: /${key}`} currentPath={`/dashboard/urls/${hostname}/`}>
	<nav class="breadcrumb">
		<a href="/dashboard/">ダッシュボード</a>
		<span class="sep">/</span>
		<a href="/dashboard/urls/">URL管理</a>
		<span class="sep">/</span>
		<a href={`/dashboard/urls/${hostname}/`}>{hostname}</a>
		<span class="sep">/</span>
		<span class="current">/{key} を編集</span>
	</nav>

	<div class="form-card">
		<form id="editForm">
			<div class="form-group">
				<label class="form-label">短縮キー</label>
				<div class="readonly-field">
					<code>/{url.key}</code>
				</div>
				<span class="form-hint">短縮キーは変更できません。</span>
			</div>

			<div class="form-group">
				<label for="destination" class="form-label">遷移先URL <span class="required">*</span></label>
				<input
					type="url"
					id="destination"
					name="destination"
					class="form-input"
					value={url.destination}
					required
				/>
			</div>

			<div class="form-group">
				<label for="comment" class="form-label">コメント</label>
				<textarea
					id="comment"
					name="comment"
					class="form-input form-textarea"
					rows="3"
				>{url.comment}</textarea>
				<span class="form-hint">管理用のメモを自由に記入できます。</span>
			</div>

			<div class="form-group">
				<label class="form-label">統計</label>
				<div class="stats-display">
					<div class="stat-row">
						<span class="stat-label-text">作成日</span>
						<span class="stat-val">{new Date(url.createdAt).toLocaleDateString('ja-JP')}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label-text">総アクセス数</span>
						<span class="stat-val">{url.totalClicks.toLocaleString()}</span>
					</div>
				</div>
			</div>

			<div class="form-actions">
				<a href={`/dashboard/urls/${hostname}/`} class="btn btn-secondary">キャンセル</a>
				<button type="submit" class="btn btn-primary">保存する</button>
			</div>
		</form>
	</div>

	<!-- 保存成功メッセージ -->
	<div class="toast" id="successToast" hidden>
		<span>✅ 変更を保存しました</span>
	</div>
</DashboardLayout>

<script>
	const form = document.getElementById('editForm') as HTMLFormElement;
	const toast = document.getElementById('successToast')!;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		const destination = (document.getElementById('destination') as HTMLInputElement).value;
		const comment = (document.getElementById('comment') as HTMLTextAreaElement).value;
		const key = form.closest('[data-key]')?.getAttribute('data-key')
			?? window.location.pathname.split('/').filter(Boolean).at(-2) ?? '';

		try {
			const res = await fetch(`/api/urls/${key}`, {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ destination, comment }),
			});
			if (res.ok) {
				toast.hidden = false;
				setTimeout(() => { toast.hidden = true; }, 3000);
			} else {
				alert('保存に失敗しました。');
			}
		} catch {
			alert('保存に失敗しました。');
		}
	});
</script>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
		font-size: 0.85rem;
		flex-wrap: wrap;
	}

	.breadcrumb a { color: var(--color-text-secondary); text-decoration: none; }
	.breadcrumb a:hover { color: var(--color-primary); }
	.breadcrumb .sep { color: var(--color-text-muted); }
	.breadcrumb .current { color: var(--color-text); font-weight: 500; }

	.form-card {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 28px;
		max-width: 640px;
	}

	.form-group { margin-bottom: 22px; }

	.form-label {
		display: block;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-text);
		margin-bottom: 6px;
	}

	.required { color: var(--color-danger); }

	.form-input {
		width: 100%;
		padding: 10px 14px;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		font-size: 0.9rem;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.form-input:focus { border-color: var(--color-primary); }
	.form-input::placeholder { color: var(--color-text-muted); }

	.form-textarea {
		resize: vertical;
		min-height: 80px;
		font-family: inherit;
	}

	.form-hint {
		display: block;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		margin-top: 5px;
	}

	.readonly-field {
		padding: 10px 14px;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
	}

	.stats-display {
		background: var(--color-bg-tertiary);
		border-radius: var(--radius-md);
		padding: 14px;
	}

	.stat-row {
		display: flex;
		justify-content: space-between;
		padding: 6px 0;
	}

	.stat-row + .stat-row {
		border-top: 1px solid var(--color-border);
		margin-top: 4px;
		padding-top: 10px;
	}

	.stat-label-text { font-size: 0.85rem; color: var(--color-text-secondary); }
	.stat-val { font-size: 0.88rem; font-weight: 600; color: var(--color-text); }

	.form-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 28px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 20px;
		border-radius: var(--radius-md);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.15s ease;
	}

	.btn-primary { background: var(--color-primary); color: #fff; }
	.btn-primary:hover { background: var(--color-primary-hover); }
	.btn-secondary {
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
	}
	.btn-secondary:hover { color: var(--color-text); background: var(--color-bg-hover); }

	/* トースト */
	.toast {
		position: fixed;
		bottom: 24px;
		right: 24px;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-success);
		border-radius: var(--radius-md);
		padding: 12px 20px;
		font-size: 0.9rem;
		color: var(--color-success);
		font-weight: 500;
		z-index: 1000;
		animation: slideIn 0.3s ease;
	}

	.toast[hidden] { display: none; }

	@keyframes slideIn {
		from {
			transform: translateY(20px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}
</style>
