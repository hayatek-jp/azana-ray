interface Props {
    items: { label: string; value: number; percentage: number }[];
    title: string;
}

const { items, title } = Astro.props;
const colors = ['#6c8aff', '#4ade80', '#fbbf24', '#f87171', '#38bdf8', '#a78bfa', '#fb923c'];
---

<div class="dist-card">
    <h3 class="dist-title">{title}</h3>
    <div class="dist-list">
        {items.map((item, idx) => (
            <div class="dist-item">
                <div class="dist-item-header">
                    <span class="dist-dot" style={`background: ${colors[idx % colors.length]}`} />
                    <span class="dist-label">{item.label}</span>
                    <span class="dist-count">{item.value.toLocaleString()}</span>
                </div>
                <div class="dist-bar-bg">
                    <div
                        class="dist-bar-fill"
                        style={`width: ${item.percentage}%; background: ${colors[idx % colors.length]}`}
                    />
                </div>
                <span class="dist-pct">{item.percentage}%</span>
            </div>
        ))}
    </div>
</div>

<style>
    .dist-card {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 20px;
    }

    .dist-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: 16px;
    }

    .dist-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dist-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px;
    }

    .dist-item-header {
        display: flex;
        align-items: center;
        gap: 8px;
        grid-column: 1 / -1;
    }

    .dist-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dist-label {
        font-size: 0.85rem;
        color: var(--color-text);
        flex: 1;
    }

    .dist-count {
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        font-weight: 500;
    }

    .dist-bar-bg {
        height: 6px;
        background: var(--color-bg-tertiary);
        border-radius: 3px;
        overflow: hidden;
    }

    .dist-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .dist-pct {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        text-align: right;
        font-weight: 600;
    }
</style>
